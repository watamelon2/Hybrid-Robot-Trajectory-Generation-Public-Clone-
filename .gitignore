# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# --- Virtual envs (legacy local venv before we moved to conda) ---
mbd_env/
mbd_env
hybrid-traj/

# --- Build / cache outputs ---
docs/_build/
.cache/
.pytest_cache/

# --- Heavy third-party checkouts (keep out of repo) ---
third_party/
mujoco_menagerie/

# --- Robomimic / experiment artefacts ---
experiments/**/results/*.hdf5
experiments/**/results/**/*.hdf5
experiments/**/results/*.mp4
experiments/**/results/**/*.mp4
experiments/**/results/videos/
experiments/**/results/videos_*/
experiments/**/results/*.pt
experiments/**/results/**/*.pt
experiments/**/results/cache/

# Bulky derived HDF5 banks for the incremental-adaptation slate; the
# collect slate (slate_incremental_collect_*) regenerates them from
# the robomimic dataset in ~10 min.  Cache .npz files alongside them
# (filename starts with a dot) are also derived.
experiments/15_unified_hybrid/data/

# Local backup of pre-final smoke runs that we moved aside before
# rerunning the real sweep. Useful on disk for spot checks, but
# noisy in `git status` and not worth versioning.
experiments/**/results/_stale_smoke_backup/
experiments/**/results/_archive/

# --- Local run logs (per-cell stdout/stderr from scripts/local/*) ---
# Bulky, run-specific timing data. Not source-of-truth for any result.
logs/

# --- Local-only notes / draft messages (kept on disk for reference) ---
scripts/local/charles_pre_pull_message.txt

# --- macOS / editor cruft ---
.DS_Store
*.swp
.idea/
.vscode/
.windsurf/

# --- LaTeX build artefacts (docs/) ---
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
