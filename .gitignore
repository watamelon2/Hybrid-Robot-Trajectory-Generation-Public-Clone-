*.lof
*.lot
*.run.xml
*-blx.bib
*.bcf

# --- Compiled PDFs (built from LaTeX sources in docs/) ---
docs/**/*.pdf

# --- Academic paper PDFs (kept locally, not in repo) ---
docs/papers/*.pdf

# --- Local Zotero helper script (not part of the project) ---
docs/papers/fix_zotero_keys.js

# --- Progress-report example templates (kept locally for reference) ---
docs/progress_reports/examples/
experiments/**/results/_archive_old_bc/

# MuJoCo internal log spew
MUJOCO_LOG.TXT

# --- macOS iCloud / Finder duplicates ---
# iCloud's "Optimize Storage" and Finder's Duplicate action create copies
# named like `foo 2.md`, `done 2`, `pid 2`, etc.  These are never wanted
# in the repo.  Patterns match: " 2" before any extension, and " 2" at
# the end of a filename with no extension.
* 2.*
* 2

# --- aborted training-run logs ---
*.partial_early_fire
